# Configuración de Firebase para JV Cats La Tienda
# Obtén estas claves en: https://console.firebase.google.com/u/2/project/jvcatslatienda/settings/general
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=jvcatslatienda.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=jvcatslatienda
VITE_FIREBASE_STORAGE_BUCKET=jvcatslatienda.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Correos con privilegios de Administrador automáticos al iniciar con Google
VITE_ADMIN_EMAILS=admin@jvcats.com,mercadeojvcatslatienda@gmail.com
